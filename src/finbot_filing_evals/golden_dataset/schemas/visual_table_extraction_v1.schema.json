{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finbot.local/schemas/visual_table_extraction.v1.json",
  "title": "Visual Table Extraction V1",
  "description": "Provider-neutral transcription of one financial-statement screenshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement_title_raw",
    "units_raw",
    "rows",
    "columns",
    "cells"
  ],
  "properties": {
    "statement_title_raw": {
      "description": "Exact visible statement title, or null when no title is visible.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "units_raw": {
      "description": "Exact visible statement-level units text, or null when absent.",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/column"}
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    }
  },
  "$defs": {
    "rawPath": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_index", "row_path_raw", "row_kind"],
      "properties": {
        "row_index": {"type": "integer", "minimum": 0},
        "row_path_raw": {"$ref": "#/$defs/rawPath"},
        "row_kind": {
          "type": "string",
          "enum": ["data", "section_heading"]
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["column_index", "column_path_raw"],
      "properties": {
        "column_index": {"type": "integer", "minimum": 0},
        "column_path_raw": {"$ref": "#/$defs/rawPath"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_index", "column_index", "value_raw"],
      "properties": {
        "row_index": {"type": "integer", "minimum": 0},
        "column_index": {"type": "integer", "minimum": 0},
        "value_raw": {"type": "string"}
      }
    }
  }
}
