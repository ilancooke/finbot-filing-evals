# Shared finbot data directory. API credentials are intentionally not needed
# until provider adapters are implemented in Milestones 2 and 3.
FINBOT_DATA_ROOT=/absolute/path/to/finbot/data

# Optional path overrides. Defaults are derived from FINBOT_DATA_ROOT.
# FINBOT_GOLDEN_DATASET_SOURCE_ROOT=/absolute/path/to/screenshots
# FINBOT_GOLDEN_DATASET_INTERMEDIATE_ROOT=/absolute/path/to/intermediate
# FINBOT_GOLDEN_DATASET_PROCESSED_ROOT=/absolute/path/to/processed

# Reserved for future opt-in provider adapters. Never commit actual values.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# QWEN_API_KEY=

